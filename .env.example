WAHA_API_KEY=replace_with_a_strong_random_api_key
WAHA_HOST=0.0.0.0
WAHA_PORT=3000
WAHA_MONGO_URL=mongodb://localhost:27017
WAHA_MONGO_DB=whatsapp_api
WAHA_WEBHOOK_URL=
WAHA_AUTO_START_SESSIONS=default

# Inbound API Rate Limiting
WAHA_RATE_LIMIT_ENABLED=true
WAHA_RATE_LIMIT_RPM=60

# Outbound Anti-Ban Message Queue & Human Pacing
WAHA_QUEUE_ENABLED=true
WAHA_QUEUE_MIN_DELAY=2.0
WAHA_QUEUE_MAX_DELAY=5.0
WAHA_QUEUE_SIMULATE_TYPING=true
WAHA_QUEUE_TYPING_MIN_SECONDS=1.0
WAHA_QUEUE_TYPING_MAX_SECONDS=3.0
WAHA_QUEUE_MAX_PER_MINUTE=20
WAHA_QUEUE_MAX_PER_HOUR=250

# Session Storage & Backup
WAHA_SESSIONS_DIR=./.sessions
WAHA_SESSION_BACKUP_INTERVAL=60
